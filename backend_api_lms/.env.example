# Database Configuration (Docker MySQL)
DATABASE_URL="mysql://lms_user:lms_password@127.0.0.1:3306/lms_db"

# JWT Authentication
JWT_SECRET="lms-super-secret-key-2026"
JWT_EXPIRES_IN="7d"

# Redis Cache (Docker Redis)
# Run `docker compose up -d` to start Redis on port 6379
REDIS_URL="redis://127.0.0.1:6379"
REDIS_ENABLED="true"

# Server Port
PORT=3000
