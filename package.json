{
  "name": "backend-api-lms",
  "version": "1.0.0",
  "description": "LMS Backend API for Teacher Dashboard",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:ps": "docker compose ps",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:reset": "node prisma/reset.js",
    "db:studio": "prisma studio",
    "test": "node --test tests/**/*.test.js",
    "test:teacher": "node --test tests/teacher.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.0.0"
  }
}
